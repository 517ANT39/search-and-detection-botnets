# ==== Базовый адрес HTTP API ====
# Все запросы httpClient будут отправляться на этот адрес + путь из src/api/endpoints.js
VITE_API_BASE_URL=/api

# ==== Адрес WebSocket сервера ====
# Полный URL (ws:// или wss://). Пример: ws://localhost:8000/ws
VITE_WS_URL=/ws

# ==== Режим заглушек (моков) ====
# true  -> интерфейс работает на сгенерированных тестовых данных (без бэкенда)
# false -> все данные идут через реальные HTTP/WS запросы к вашему backend
VITE_USE_MOCK=true

# Название заголовка авторизации и его схема (Bearer, Token и т.д.)
VITE_AUTH_HEADER=Authorization
VITE_AUTH_SCHEME=Bearer
